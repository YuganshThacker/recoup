# Copy to .env and fill in. .env is gitignored and must never be committed.
# An already-exported variable takes precedence over anything set here.

OPENAI_API_KEY=

# Only needed for --provider anthropic
ANTHROPIC_API_KEY=

# Razorpay test mode only. Dashboard > Test Mode > Settings > API Keys.
# A live key is refused: Batch C creates real objects.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Whatever you configure at Dashboard > Settings > Webhooks.
RAZORPAY_WEBHOOK_SECRET=
